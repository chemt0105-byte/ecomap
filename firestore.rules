rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidObservation(data) {
      return data.id is string && data.id.size() <= 128
        && data.speciesName is string && data.speciesName.size() > 0 && data.speciesName.size() <= 100
        && data.category is string && data.category in ['plant', 'animal', 'bird', 'insect', 'fungi', 'other']
        && data.classId is string && data.classId.size() <= 50
        && data.observerName is string && data.observerName.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && (!('locationDescription' in data) || (data.locationDescription is string && data.locationDescription.size() <= 300))
        && (!('scientificName' in data) || (data.scientificName is string && data.scientificName.size() <= 100))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 800000))
        && (!('deletePassword' in data) || (data.deletePassword is string && data.deletePassword.size() <= 50))
        && (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128));
    }

    match /observations/{observationId} {
      allow read: if true;
      allow create: if isValidId(observationId) && isValidObservation(incoming());
      allow update: if isValidId(observationId) && isValidObservation(incoming());
      allow delete: if isValidId(observationId);
    }
  }
}
